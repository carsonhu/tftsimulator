    "Caitlyn.maxMana": {
      "code": -1,
      "reference": 3,
      "why": "-1 disables casting entirely (canCast needs fullMana > -1). Headshot is an attack replacement, not a cast, so she must never spend mana."
    },
    "MasterYi.maxMana": {
      "code": -1,
      "reference": 3,
      "why": "Same as Caitlyn: Double Strike is a passive third attack, handled by MasterYiUlt, not a real cast."
    },
    "Nidalee.maxMana": {
      "code": 45,
      "reference": 40,
      "why": "Changed to 0/45 on PBE; cdragon's dump still says 40. Its PBE data can lag the live PBE build, and a confirmed card reading wins when it does."
    }
  },
